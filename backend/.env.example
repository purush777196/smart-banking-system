# ==============================================================================
# Finova Banking Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#
# PowerShell:
#   $env:DB_PASSWORD="your_postgres_password"
#   $env:JWT_SECRET="generate_a_secure_256_bit_random_hex_or_string_key_minimum_32_chars"
#   $env:JWT_EXPIRATION="86400000"
# ==============================================================================

# PostgreSQL database password for user 'postgres'
DB_PASSWORD=your_postgres_password

# 256-bit HMAC signing secret for JWT token creation (must be at least 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# JWT expiration time in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION=86400000

